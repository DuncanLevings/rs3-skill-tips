{
  "$schema": "https://raw.githubusercontent.com/LuaLS/vscode-lua/master/setting/schema.json",
  "runtime.version": "Lua 5.4",
  "runtime.path": [
    "?.lua",
    "?/init.lua"
  ],
  "diagnostics.globals": [
    "log",
    "PluginShutdown",
    "Event",
    "prettyui",
    "ui",
    "id",
    "config",
    "var",
    "PersistentDB",
    "Player",
    "Inventory",
    "GameState",
    "Keyboard",
    "Plugin",
    "Vector4"
  ],
  "workspace.checkThirdParty": false,
  "workspace.ignoreDir": [
    ".git",
    "dist",
    "work"
  ]
}
